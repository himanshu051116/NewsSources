NEWSINTEL_ENVIRONMENT=development
NEWSINTEL_LOG_LEVEL=INFO
NEWSINTEL_API_HOST=127.0.0.1
NEWSINTEL_API_PORT=8010
NEWSINTEL_PUBLIC_BASE_URL=http://127.0.0.1:8010
NEWSINTEL_DATABASE_URL=postgresql+asyncpg://newsintel:newsintel@localhost:5434/newsintel
NEWSINTEL_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Redis is reserved for the optional future event-bus profile and is not started by default.
NEWSINTEL_REDIS_URL=redis://localhost:6380/0
NEWSINTEL_QDRANT_URL=http://localhost:6333
NEWSINTEL_OBJECT_STORE_ENDPOINT=http://localhost:9010
NEWSINTEL_OBJECT_STORE_BUCKET=newsintel
NEWSINTEL_OBJECT_STORE_ACCESS_KEY=newsintel
NEWSINTEL_OBJECT_STORE_SECRET_KEY=change-me
NEWSINTEL_CRAWLER_USER_AGENT=NewsIntelligenceBot/0.1 (+https://example.invalid/crawler)
NEWSINTEL_CRAWLER_ROBOTS_ENABLED=true
NEWSINTEL_CRAWLER_ROBOTS_CACHE_SECONDS=3600
NEWSINTEL_CRAWLER_FAIL_CLOSED_ON_ROBOTS_ERROR=true
NEWSINTEL_CRAWLER_MAX_CONCURRENT_PER_HOST=2
NEWSINTEL_CRAWLER_MIN_HOST_INTERVAL_SECONDS=0.25

# Optional sandboxed browser-rendering fallback for publisher profiles that explicitly enable it.
# Start separately with: .\scripts\browser-renderer.ps1 up
NEWSINTEL_BROWSER_RENDERER_ENABLED=false
NEWSINTEL_BROWSER_RENDERER_URL=http://127.0.0.1:8025
NEWSINTEL_BROWSER_RENDERER_TOKEN=
NEWSINTEL_BROWSER_RENDERER_TIMEOUT_SECONDS=35
NEWSINTEL_BROWSER_RENDERER_MAX_HTML_BYTES=8000000
NEWSINTEL_BROWSER_RENDERER_MIN_WORD_COUNT=80
NEWSINTEL_BROWSER_RENDERER_MIN_QUALITY_SCORE=0.45

# Authentication is disabled by default in local templates.
# For local-only development without an identity provider, set this explicitly:
# NEWSINTEL_DEV_AUTH_BYPASS_ENABLED=true
NEWSINTEL_AUTH_MODE=disabled
NEWSINTEL_AUTH_PROVIDER_NAME=oidc
NEWSINTEL_AUTH_JWT_ISSUER=
NEWSINTEL_AUTH_JWT_AUDIENCE=
NEWSINTEL_AUTH_JWT_JWKS_URL=
NEWSINTEL_AUTH_JWT_ALGORITHMS=RS256
NEWSINTEL_AUTH_JWT_HS256_SECRET=
NEWSINTEL_AUTH_OIDC_AUTHORIZATION_URL=
NEWSINTEL_AUTH_OIDC_TOKEN_URL=
NEWSINTEL_AUTH_OIDC_CLIENT_ID=
NEWSINTEL_AUTH_OIDC_CLIENT_SECRET=
NEWSINTEL_AUTH_OIDC_REDIRECT_URI=http://127.0.0.1:8010/auth/callback
NEWSINTEL_AUTH_SESSION_SECRET=
NEWSINTEL_AUTH_COOKIE_SECURE=false
NEWSINTEL_AUTH_COOKIE_SAMESITE=lax
NEWSINTEL_DEV_AUTH_BYPASS_ENABLED=false
NEWSINTEL_BOOTSTRAP_OWNER_PROVIDER=
NEWSINTEL_BOOTSTRAP_OWNER_USER_ID=
NEWSINTEL_BOOTSTRAP_OWNER_EMAIL=
NEWSINTEL_CORS_ALLOWED_ORIGINS=

NEWSINTEL_RAW_ARTIFACT_STORE_BACKEND=local
NEWSINTEL_S3_ARTIFACT_PREFIX=raw-html
NEWSINTEL_S3_ARTIFACT_SSE=
NEWSINTEL_POLL_WORKER_BATCH_SIZE=20
NEWSINTEL_POLL_WORKER_CONCURRENCY=5
NEWSINTEL_POLL_WORKER_LEASE_SECONDS=120
NEWSINTEL_POLL_WORKER_IDLE_SECONDS=2
NEWSINTEL_OUTBOX_WORKER_BATCH_SIZE=50
NEWSINTEL_OUTBOX_WORKER_IDLE_SECONDS=2
NEWSINTEL_DATABASE_RETRY_MAX_SECONDS=30
NEWSINTEL_ARTICLE_WORKER_BATCH_SIZE=20
NEWSINTEL_ARTICLE_WORKER_CONCURRENCY=5
NEWSINTEL_ARTICLE_WORKER_LEASE_SECONDS=120
NEWSINTEL_ARTICLE_WORKER_IDLE_SECONDS=2
NEWSINTEL_ARTICLE_FETCH_MAX_ATTEMPTS=3
NEWSINTEL_ARTICLE_FETCH_RETRY_BASE_SECONDS=120
NEWSINTEL_ARTICLE_FETCH_RETRY_MAX_SECONDS=3600
NEWSINTEL_ARTICLE_FETCH_RETRY_JITTER_RATIO=0.15
NEWSINTEL_RECENT_ARTICLE_WINDOW_HOURS=48
NEWSINTEL_MAX_NEW_URLS_PER_CHANNEL_POLL=200
NEWSINTEL_MAX_NEW_URLS_PER_PUBLISHER_FETCH=300
NEWSINTEL_MAX_NEW_URLS_PER_FETCH_JOB=2000
NEWSINTEL_MAX_ACTIVE_CHANNELS_PER_PUBLISHER=25
NEWSINTEL_DISCOVERY_RECOVERY_WINDOW_DAYS=7
NEWSINTEL_INITIAL_BACKFILL_DAYS=3
NEWSINTEL_MAX_RETRIES=3
NEWSINTEL_WORKER_LEASE_SECONDS=120
NEWSINTEL_DEAD_LETTER_AFTER_ATTEMPTS=3

# Historical research providers. Never commit real API keys.
# Keyless providers available immediately: GDELT, Internet Archive Wayback, Common Crawl.
NEWSINTEL_HISTORICAL_SEARCH_ENABLED=true
NEWSINTEL_HISTORICAL_PROVIDER_TIMEOUT_SECONDS=15
NEWSINTEL_HISTORICAL_PROVIDER_MAX_RESULTS=100
# Automatic historical context is queued for every committed article version.
NEWSINTEL_HISTORICAL_ENRICHMENT_ENABLED=true
# External historical search is asynchronous; internal corpus/event history always runs even if providers fail.
NEWSINTEL_HISTORICAL_ENRICHMENT_EXTERNAL_ENABLED=true
NEWSINTEL_HISTORICAL_ENRICHMENT_BATCH_SIZE=10
NEWSINTEL_HISTORICAL_ENRICHMENT_CONCURRENCY=2
NEWSINTEL_HISTORICAL_ENRICHMENT_LEASE_SECONDS=300
NEWSINTEL_HISTORICAL_ENRICHMENT_IDLE_SECONDS=2
NEWSINTEL_HISTORICAL_ENRICHMENT_MAX_ATTEMPTS=3
NEWSINTEL_HISTORICAL_ENRICHMENT_MAX_QUERIES=3
NEWSINTEL_HISTORICAL_ENRICHMENT_INTERNAL_LIMIT=25
NEWSINTEL_HISTORICAL_ENRICHMENT_EXTERNAL_LIMIT_PER_QUERY=15
NEWSINTEL_DERIVED_RECOMPUTE_BATCH_SIZE=20
NEWSINTEL_DERIVED_RECOMPUTE_LEASE_SECONDS=120
NEWSINTEL_DERIVED_RECOMPUTE_IDLE_SECONDS=2
NEWSINTEL_WORKSPACE_MONITOR_BATCH_SIZE=20
NEWSINTEL_WORKSPACE_MONITOR_LEASE_SECONDS=180
NEWSINTEL_WORKSPACE_MONITOR_IDLE_SECONDS=5
NEWSINTEL_COMMON_CRAWL_COLLECTION_COUNT=3
NEWSINTEL_GUARDIAN_API_KEY=
NEWSINTEL_NEW_YORK_TIMES_API_KEY=
NEWSINTEL_NEWS_API_KEY=
NEWSINTEL_GOOGLE_FACT_CHECK_API_KEY=

# Local AI only. No paid API fallback is enabled.
NEWSINTEL_AI_PROVIDER=disabled
NEWSINTEL_LOCAL_MODEL_BASE_URL=http://localhost:11434
# Local semantic article indexing is opt-in. It powers historical semantic context and the v1.20 benchmark-only article reranking experiment; production Intelligence Search remains lexical.
NEWSINTEL_SEMANTIC_SEARCH_ENABLED=false
NEWSINTEL_SEMANTIC_EMBEDDING_MODEL=nomic-embed-text
NEWSINTEL_SEMANTIC_VECTOR_SIZE=768
NEWSINTEL_SEMANTIC_QDRANT_COLLECTION=article_versions_v1
NEWSINTEL_SEMANTIC_TIMEOUT_SECONDS=20
NEWSINTEL_SEMANTIC_INDEX_BATCH_SIZE=32
NEWSINTEL_SEMANTIC_SEARCH_LIMIT=20
