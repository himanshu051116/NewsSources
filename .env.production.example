# Copy to .env.production and replace every CHANGE_ME value before deployment.
NEWSINTEL_DOMAIN=news.example.com
POSTGRES_DB=newsintel
POSTGRES_USER=newsintel
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
MINIO_ROOT_USER=newsintel-storage
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD

NEWSINTEL_ENVIRONMENT=production
NEWSINTEL_LOG_LEVEL=INFO
NEWSINTEL_API_HOST=0.0.0.0
NEWSINTEL_API_PORT=8010
NEWSINTEL_PUBLIC_BASE_URL=https://news.example.com
NEWSINTEL_DATABASE_URL=postgresql+asyncpg://newsintel:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/newsintel
NEWSINTEL_DATABASE_CONNECT_TIMEOUT_SECONDS=10
NEWSINTEL_QDRANT_URL=http://qdrant:6333
NEWSINTEL_OBJECT_STORE_ENDPOINT=http://minio:9000
NEWSINTEL_OBJECT_STORE_BUCKET=newsintel
NEWSINTEL_OBJECT_STORE_ACCESS_KEY=newsintel-storage
NEWSINTEL_OBJECT_STORE_SECRET_KEY=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD
NEWSINTEL_RAW_ARTIFACT_STORE_BACKEND=s3
NEWSINTEL_S3_ARTIFACT_PREFIX=raw-html

NEWSINTEL_CRAWLER_USER_AGENT=NewsIntelligenceBot/1.25 (+https://news.example.com/crawler)
NEWSINTEL_CRAWLER_ROBOTS_ENABLED=true
NEWSINTEL_CRAWLER_FAIL_CLOSED_ON_ROBOTS_ERROR=true
NEWSINTEL_CRAWLER_MAX_CONCURRENT_PER_HOST=2
NEWSINTEL_CRAWLER_MIN_HOST_INTERVAL_SECONDS=0.5

NEWSINTEL_AUTH_MODE=oidc
NEWSINTEL_AUTH_PROVIDER_NAME=oidc
NEWSINTEL_AUTH_JWT_ISSUER=https://CHANGE_ME_IDP/
NEWSINTEL_AUTH_JWT_AUDIENCE=CHANGE_ME_AUDIENCE
NEWSINTEL_AUTH_JWT_JWKS_URL=https://CHANGE_ME_IDP/.well-known/jwks.json
NEWSINTEL_AUTH_JWT_ALGORITHMS=RS256
NEWSINTEL_AUTH_OIDC_AUTHORIZATION_URL=https://CHANGE_ME_IDP/authorize
NEWSINTEL_AUTH_OIDC_TOKEN_URL=https://CHANGE_ME_IDP/oauth/token
NEWSINTEL_AUTH_OIDC_CLIENT_ID=CHANGE_ME
NEWSINTEL_AUTH_OIDC_CLIENT_SECRET=CHANGE_ME_AT_LEAST_16_CHARACTERS
NEWSINTEL_AUTH_OIDC_REDIRECT_URI=https://news.example.com/auth/callback
NEWSINTEL_AUTH_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
NEWSINTEL_AUTH_COOKIE_SECURE=true
NEWSINTEL_AUTH_COOKIE_SAMESITE=lax
NEWSINTEL_DEV_AUTH_BYPASS_ENABLED=false
NEWSINTEL_CORS_ALLOWED_ORIGINS=https://news.example.com
NEWSINTEL_BOOTSTRAP_OWNER_EMAIL=admin@example.com

NEWSINTEL_HISTORICAL_SEARCH_ENABLED=true
NEWSINTEL_HISTORICAL_ENRICHMENT_ENABLED=true
NEWSINTEL_HISTORICAL_ENRICHMENT_EXTERNAL_ENABLED=true
NEWSINTEL_GUARDIAN_API_KEY=
NEWSINTEL_NEW_YORK_TIMES_API_KEY=
NEWSINTEL_NEWS_API_KEY=
NEWSINTEL_GOOGLE_FACT_CHECK_API_KEY=

# Optional local semantic layer. Keep disabled until benchmark/promotion gates approve it.
NEWSINTEL_AI_PROVIDER=disabled
NEWSINTEL_SEMANTIC_SEARCH_ENABLED=false
NEWSINTEL_LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434
NEWSINTEL_SEMANTIC_EMBEDDING_MODEL=nomic-embed-text
NEWSINTEL_SEMANTIC_VECTOR_SIZE=768
NEWSINTEL_SEMANTIC_QDRANT_COLLECTION=article_versions_v1

# Optional renderer; if enabled also run compose with --profile browser-renderer.
NEWSINTEL_BROWSER_RENDERER_ENABLED=false
NEWSINTEL_BROWSER_RENDERER_URL=http://browser-renderer:8025
NEWSINTEL_BROWSER_RENDERER_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
